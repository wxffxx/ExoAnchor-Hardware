{"type":"TABLE","ticket":676872,"id":"a8a49a12a7d3e131"}||{"startX":305,"startY":760,"rotation":0,"rowSizes":[300],"colSizes":[275],"rowLocked":[0],"colLocked":[0],"tableCell":[{"id":"7baf17f3e3e87efb","zIndex":0,"lineHeight":null,"value":"CAUTION — CHIP REVISION\nESP32-P4NRW16/32 and ESP32-P4NRW16X/32X use different IC revisions and are not drop-in compatible.\n\nNon-X version, chip revision v1.x: Pin 54 is NC and must be left unconnected.\n\nX version, chip revision v3.x: Pin 54 is VDD_HP and must be connected to the VDD_HP power rail.\n\nv1.x and v3.x require separate firmware builds and cannot use the same firmware image.\n\nESP32-P4NRW16/32 is planned for EOL. ESP32-P4NRW16X/32X is recommended for new designs. But some Dev Board still use Non-X version chip\n\nVerify the exact chip part number and revision before PCB assembly. ","rowIndex":0,"rowSpan":1,"columnIndex":0,"colSpan":1,"topStyle":{"strokeColor":null,"strokeStyle":null,"strokeWidth":null,"fillStyle":null,"fillColor":null},"rightStyle":{"strokeColor":null,"strokeStyle":null,"strokeWidth":null,"fillStyle":null,"fillColor":null},"bottomStyle":{"strokeColor":null,"strokeStyle":null,"strokeWidth":null,"fillStyle":null,"fillColor":null},"leftStyle":{"strokeColor":null,"strokeStyle":null,"strokeWidth":null,"fillStyle":null,"fillColor":null},"fontStyle":{"hAlign":null,"vAlign":null,"color":null,"fillColor":null,"fontFamily":null,"fontSize":12,"fontWeight":null,"italic":null,"underline":null,"strikeout":null}}],"zIndex":1349,"yAxisDirection":"up"}|
